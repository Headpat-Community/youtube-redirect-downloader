PORT=3000
POSTGRES_DB=videos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# s3 or local
STORAGE_DRIVER=s3

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-me-access-key
S3_SECRET_KEY=replace-me-secret-key
S3_BUCKET=videos
S3_REGION=us-east-1

# only used when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/data/videos
LOCAL_STORAGE_SECRET=replace-me-with-a-random-string

VIDEO_TTL_HOURS=24
MAX_CONCURRENT_DOWNLOADS=3
PRESIGN_EXPIRY_SECONDS=3600
CLEANUP_INTERVAL_MINUTES=15
